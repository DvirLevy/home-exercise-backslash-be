{
  "name": "home-exercise-backslash-be",
  "version": "1.0.0",
  "private": true,
  "description": "Graph analysis platform backend - Backslash Security home assignment",
  "license": "UNLICENSED",
  "type": "commonjs",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cors": "2.8.6",
    "express": "5.3.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prisma": "7.10.1",
    "swagger-ui-express": "5.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "4.1.8",
    "jest": "30.5.2",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "@scarf/scarf": false,
    "@parcel/watcher": false,
    "fsevents": false
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate"
  }
}
