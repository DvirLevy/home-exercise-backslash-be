    { "from": "payment-service", "to": ["order-service", "fraud-check"] },
    { "from": "search-service", "to": ["search-service", "recommendation-service", "session-cache"] },
    { "from": "recommendation-service", "to": "search-service" },
    { "from": "events-queue", "to": "notification-service" },
    { "from": "notification-service", "to": [] },
    { "from": "external-cron", "to": "inventory-service", "schedule": "*/5 * * * *" },
    { "from": "inventory-service", "to": "orders-db" },
    { "from": "admin-panel", "to": ["analytics-dw", "orders-db"] }
